# Track source, tests, configuration, documentation and approved public aggregates.
/*
!/.gitignore
!/README.md
!/app.js
!/index.html
!/styles.css
!/playwright.config.js
!/playwright.pages.config.js
!/package.json
!/package-lock.json
!/requirements.txt
!/*.pyt
!/src/
!/scripts/
!/tests/
!/config/
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/pages.yml
!/public/
/public/*
!/public/data/
/public/data/*
!/public/data/analysis.json
!/public/data/manifest.json
!/public/data/members.geojson
!/public/data/membership-report.json
!/public/data/snap-report.json
!/public/data/routes/
/public/data/routes/*
!/public/data/routes/group-*.geojson

# Never track binary data, local credentials, caches or installed dependencies.
*.[pP][bB][fF]
*.[xX][lL][sS][xX]
*.xlsx:Zone.Identifier
*.osm
*.osm.gz
*.osm.bz2
*.py[cod]
__pycache__/
node_modules/
test-results-pages/
.venv/
.env
.env.*
.DS_Store
